# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtualenvs
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Large Model Weights & Embeddings (Local weights shouldn't bloat git repo)
models/
app/models/
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.onnx

# Temporary data / user files / storage index
app/storage/files/*
!app/storage/files/.gitkeep
*.tv
*.tmp
*.log

# Antigravity & IDE
.system_generated/
.gemini/
.idea/
.vscode/

# OS generated files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store

# Runtime secrets / calibration / logs (generated by app/llm_launcher.py)
app/storage/llama_api_key.txt
app/storage/ctx_calibration.json
app/storage/llama_server.log
app/storage/*.tmp
.pytest_cache/

# Agent config (may contain MCP secrets)
app/storage/agent/
app/storage/embedding_backend.txt
app/storage/kg/

# Local secrets & personal data (purged from history 2026-09-29; templates: *.example.json)
.agents/mcp_config.json
app/storage/mcp_settings.json
app/storage/memory_history.json
app/storage/active_files.json
_backup_before_secret_purge.bundle

# Test files & test outputs (not uploaded to GitHub)
tests/
app/tests/
scratch/test_*
scratch/bench_*
scratch/*test*
scratch/*.log
scratch/*.txt
scratch/*.json
Claude outputs/
output.md
output.txt
BUG.md
GOAL.md

